# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# NEVER commit real keys. The service-role key in particular grants full access.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. Keep it out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Download token signing (slice: paid delivery) -------------------------
# Any long random string, e.g. `openssl rand -hex 32`.
DOWNLOAD_TOKEN_SECRET=

# --- Mercado Pago (slices: checkout / webhook) -----------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Email delivery (slice: paid delivery) ---------------------------------
EMAIL_API_KEY=
EMAIL_FROM=

# --- Contact form email (nodemailer + Gmail SMTP) --------------------------
# The contact form sends each enquiry FROM this Gmail account TO the Luz Roja
# inbox, with Reply-To set to the visitor. Server-only — never exposed to the
# client. If unset, every submit falls back to the visitor's mail client
# (mailto), so set BOTH in Vercel (production) as well as locally.
# GMAIL_APP_PASSWORD is a 16-char Google App Password, NOT the account password:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Google Account > Security > App passwords > generate one for "Mail".
#   3. Paste it here without spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Store launch gate ------------------------------------------------------
# The public store ships behind a curtain: every /tienda page and the free
# download endpoint show/redirect to the "PREPARATE" placeholder unless this
# is exactly "true". Unset or anything else = closed (safe default), so a
# deploy can never launch the store by accident. The admin panel and the
# Mercado Pago webhook are never gated.
# Launch day: set TIENDA_ABIERTA=true in Vercel (production) and redeploy.
TIENDA_ABIERTA=
